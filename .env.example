# Copy this file to .env and set the values for your local environment.
# Never commit real passwords, API keys, or session secrets.

# Server
PORT=5001
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
# Standard local PostgreSQL uses port 5432.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/universe_civilization
# Optional alternative name; DATABASE_URL takes precedence.
# LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/universe_civilization

# AI
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Public application URL
APP_URL=http://localhost:3000
