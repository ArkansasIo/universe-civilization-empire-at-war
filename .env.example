# Copy to .env and replace every placeholder.
PORT=5001
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/universe_civilization
# Optional comma-separated browser origins for credentialed API access.
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
TRUST_PROXY=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

# AI
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Authentication bootstrap: no defaults are permitted.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ROLE=founder
ADMIN_SECURITY_CODE=
DEV_AUTH_BYPASS=false
DEV_AUTH_USERNAME=
DEV_AUTH_EMAIL=
DEV_AUTH_PASSWORD=
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
ENABLE_DEMO_ACCOUNTS=false
