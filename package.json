{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-server",
    "lint": "tsc --noEmit",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/index.js",
    "server:dev": "tsx watch server/index.ts",
    "server:compile-run": "npm run server:build && npm run server:start",
    "start:bat": "start-server.bat",
    "start:sh": "bash start-server.sh",
    "build:exe": "node scripts/generate-pe-exe.cjs && node scripts/validate-exe.cjs",
    "validate:exe": "node scripts/validate-exe.cjs",
    "test:dependency": "tsx scripts/dependency-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "memoizee": "^0.4.17",
    "memorystore": "^1.6.8",
    "motion": "^12.23.24",
    "nanoid": "^6.0.1",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/memoizee": "^0.4.12",
    "@types/node": "^22.14.0",
    "@types/passport": "^1.0.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
